# docker-compose.yml 의 기본값과 맞춰둔 것. 그대로 복사해 쓰면 된다.
ENV=local
DEBUG=true

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ktc4
POSTGRES_PASSWORD=ktc4
POSTGRES_DB=ktc4
DB_ECHO=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Summary(추천 이유 문구) AI 호출용. ai/ 패키지가 이 .env 에서 읽는다.
# 비워두면 AI 를 부르지 않고 계산된 숫자만으로 만든 기본 문구가 나간다.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# 소셜 로그인. 키는 각 소셜사 개발자 콘솔에서 받는다 (BE 담당에게 문의).
# 키가 빈 소셜사는 로그인 버튼을 눌러도 503 이 난다. JWT_SECRET 은 openssl rand -hex 32 로 만든다.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8080
# 앱(안드로이드) 로그인이 끝나면 여는 딥링크. 앱 AndroidManifest 의 intent-filter 와 같아야 한다
APP_REDIRECT_URI=safebrother://auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
