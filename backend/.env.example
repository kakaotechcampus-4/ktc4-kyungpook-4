# docker-compose.yml 의 기본값과 맞춰둔 것. 그대로 복사해 쓰면 된다.
ENV=local
DEBUG=true

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ktc4
POSTGRES_PASSWORD=ktc4
POSTGRES_DB=ktc4
DB_ECHO=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Summary(추천 이유 문구) AI 호출용. ai/ 패키지가 이 .env 에서 읽는다.
# 비워두면 AI 를 부르지 않고 계산된 숫자만으로 만든 기본 문구가 나간다.
OPENAI_API_KEY=
OPENAI_BASE_URL=
